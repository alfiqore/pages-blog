<%- include("partials/header.ejs") %>
  <main class="container">

    <div class="page-heading">
      <h1>New post</h1>
      <p>Write something. You can edit or delete it later.</p>
    </div>

    <!-- Create form. In a real app the action would point to a server route. -->
    <form class="form" action="/create" method="post">

      <div class="form-field">
        <label for="title">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="Give your post a title"
          required
        />
      </div>

      <div class="form-field">
        <label for="content">Content</label>
        <textarea
          id="content"
          name="content"
          placeholder="Start writing..."
          required
        ></textarea>
      </div>

      <div class="form-actions">
        <!-- Empty left side keeps the buttons right-aligned -->
        <span></span>
        <div class="right-group">
          <a href="index.html" class="btn btn-ghost">Cancel</a>
          <button type="submit" class="btn btn-primary">Publish post</button>
        </div>
      </div>

    </form>

  </main>

<%- include("partials/footer.ejs") %>
